{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "PapelShip Developers",
  "description": "Developer documentation for PapelShip payments, store management, and qPapel software protection APIs.",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FAFAFA",
    "dark": "#0A0A0A"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://papelship.com"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "php",
        "go"
      ],
      "defaults": "required"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "tabs": [
          {
            "tab": "Guides",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get started",
                "pages": [
                  "en/index",
                  "en/quickstart"
                ]
              },
              {
                "group": "Core concepts",
                "pages": [
                  "en/guides/authentication",
                  "en/guides/errors",
                  "en/guides/idempotency"
                ]
              }
            ]
          },
          {
            "tab": "API Store",
            "icon": "credit-card",
            "groups": [
              {
                "group": "Guides",
                "pages": [
                  "en/api-store/overview",
                  "en/api-store/crypto-payments"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "api-reference/openapi/api-store.json",
                  "directory": "en/reference/api-store"
                }
              }
            ]
          },
          {
            "tab": "User API",
            "icon": "store",
            "groups": [
              {
                "group": "Guides",
                "pages": [
                  "en/user-api/overview"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "api-reference/openapi/user-api.yaml",
                  "directory": "en/reference/user-api"
                }
              }
            ]
          },
          {
            "tab": "qPapel Protection",
            "icon": "shield-halved",
            "groups": [
              {
                "group": "Guides",
                "pages": [
                  "en/qpapel/overview",
                  "en/qpapel/license-keys"
                ]
              },
              {
                "group": "Endpoints",
                "openapi": {
                  "source": "api-reference/openapi/qpapel.json",
                  "directory": "en/reference/qpapel"
                }
              }
            ]
          }
        ]
      },
      {
        "language": "tr",
        "tabs": [
          {
            "tab": "Rehberler",
            "icon": "book-open",
            "groups": [
              {
                "group": "Başlarken",
                "pages": [
                  "tr/index",
                  "tr/quickstart"
                ]
              },
              {
                "group": "Temel kavramlar",
                "pages": [
                  "tr/guides/authentication",
                  "tr/guides/errors",
                  "tr/guides/idempotency"
                ]
              }
            ]
          },
          {
            "tab": "API Store",
            "icon": "credit-card",
            "groups": [
              {
                "group": "Rehberler",
                "pages": [
                  "tr/api-store/overview",
                  "tr/api-store/crypto-payments"
                ]
              },
              {
                "group": "Endpoint'ler",
                "openapi": {
                  "source": "api-reference/openapi/api-store.json",
                  "directory": "tr/reference/api-store"
                }
              }
            ]
          },
          {
            "tab": "User API",
            "icon": "store",
            "groups": [
              {
                "group": "Rehberler",
                "pages": [
                  "tr/user-api/overview"
                ]
              },
              {
                "group": "Endpoint'ler",
                "openapi": {
                  "source": "api-reference/openapi/user-api.yaml",
                  "directory": "tr/reference/user-api"
                }
              }
            ]
          },
          {
            "tab": "qPapel Protection",
            "icon": "shield-halved",
            "groups": [
              {
                "group": "Rehberler",
                "pages": [
                  "tr/qpapel/overview",
                  "tr/qpapel/license-keys"
                ]
              },
              {
                "group": "Endpoint'ler",
                "openapi": {
                  "source": "api-reference/openapi/qpapel.json",
                  "directory": "tr/reference/qpapel"
                }
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.papelship.com",
          "icon": "gauge"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@papelship.com",
          "icon": "life-ring"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@papelship.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.papelship.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://papelship.com"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#09090B"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Inter"
  },
  "styling": {
    "codeblocks": "system"
  },
  "icons": {
    "library": "fontawesome"
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/en"
    },
    {
      "source": "/quickstart",
      "destination": "/en/quickstart"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/en/guides/:slug*"
    },
    {
      "source": "/api-store/:slug*",
      "destination": "/en/api-store/:slug*"
    },
    {
      "source": "/user-api/:slug*",
      "destination": "/en/user-api/:slug*"
    },
    {
      "source": "/qpapel/:slug*",
      "destination": "/en/qpapel/:slug*"
    }
  ]
}
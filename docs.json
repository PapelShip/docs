    {
      "source": "/quickstart",
      "destination": "/en/quickstart"
    },
    {
      "source": "/guides/:slug*",
      "destination": "/en/guides/:slug*"
    },
    {
      "source": "/user-api/:slug*",
      "destination": "/en/user-api/:slug*"
    },
    {
      "source": "/qpapel/:slug*",
      "destination": "/en/qpapel/:slug*"
    },
    {
      "source": "/papelpay/:slug*",
      "destination": "/en/papelpay/:slug*"
    },
    {
      "source": "/api-store/:slug*",
      "destination": "/en/user-api/overview",
      "permanent": true
    },
    {
      "source": "/en/api-store/:slug*",
      "destination": "/en/user-api/overview",
      "permanent": true
    },
    {
      "source": "/tr/api-store/:slug*",
      "destination": "/tr/user-api/overview",
      "permanent": true
    },
    {
      "source": "/en/reference/api-store/:slug*",
      "destination": "/en/user-api/overview",
      "permanent": true
    },
    {
      "source": "/tr/reference/api-store/:slug*",
      "destination": "/tr/user-api/overview",
      "permanent": true
    }

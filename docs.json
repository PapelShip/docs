{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "PapelShip Developers",
  "description": "Developer documentation for PapelShip payments, store management, and qPapel software protection APIs.",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://papelship.com"
  },
  "api": {
    "playground": { "display": "interactive" },
    "examples": { "languages": ["curl", "javascript", "python", "php", "go"], "defaults": "required" }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          { "group": "Get started", "pages": ["index", "quickstart"] },
          { "group": "Core concepts", "pages": ["guides/authentication", "guides/errors", "guides/idempotency"] }
        ]
      },
      {
        "tab": "API Store",
        "icon": "credit-card",
        "groups": [
          { "group": "Guides", "pages": ["api-store/overview", "api-store/crypto-payments"] },
          { "group": "Endpoints", "openapi": "api-reference/openapi/api-store.json" }
        ]
      },
      {
        "tab": "User API",
        "icon": "store",
        "groups": [
          { "group": "Guides", "pages": ["user-api/overview"] },
          { "group": "Endpoints", "openapi": "api-reference/openapi/user-api.yaml" }
        ]
      },
      {
        "tab": "qPapel Protection",
        "icon": "shield-halved",
        "groups": [
          { "group": "Guides", "pages": ["qpapel/overview", "qpapel/license-keys"] },
          { "group": "Endpoints", "openapi": "api-reference/openapi/qpapel.json" }
        ]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "Dashboard", "href": "https://app.papelship.com", "icon": "gauge" },
        { "anchor": "Support", "href": "mailto:support@papelship.com", "icon": "life-ring" }
      ]
    }
  },
  "navbar": {
    "links": [{ "label": "Support", "href": "mailto:support@papelship.com" }],
    "primary": { "type": "button", "label": "Dashboard", "href": "https://app.papelship.com" }
  },
  "contextual": { "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"] },
  "footer": { "socials": { "website": "https://papelship.com" } }
}
